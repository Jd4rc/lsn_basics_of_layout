# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=aquashop
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Cache: адрес Redis без номера базы (берутся /0 и /1). Пусто — кеш в памяти процесса
REDIS_URL=redis://127.0.0.1:6379

# Email: без EMAIL_HOST письма печатаются в консоль runserver.
# Например smtp.gmail.com или smtp.yandex.ru, пароль — пароль приложения, а не от почты
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Кому слать поздравление со 100 просмотрами; пусто — на EMAIL_HOST_USER
OWNER_EMAIL=